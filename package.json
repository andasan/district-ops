{
  "name": "district-ops",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "dotnet run --project apps/api/DistrictOps.Api/DistrictOps.Api.csproj --launch-profile http",
    "build:web": "pnpm --filter web build",
    "build:api": "dotnet build DistrictOps.slnx",
    "test:api": "dotnet test DistrictOps.slnx",
    "test:e2e": "playwright test",
    "docker:up": "docker compose up -d postgres",
    "docker:auth": "docker compose --profile auth up -d"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
